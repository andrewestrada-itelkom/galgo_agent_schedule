        </record>

        <record id="demo_schedule_wed_gracia" model="galgo.agent.schedule">
            <field name="fecha" eval="(DateTime.now() + timedelta(days=2)).strftime('%Y-%m-%d')"/>
            <field name="agent_id" ref="galgo_agent_gracia"/>
            <field name="shift_id" ref="galgo_shift_dia"/>
            <field name="state">confirmado</field>
        </record>

        <!-- Jueves -->
        <record id="demo_schedule_thu_steven" model="galgo.agent.schedule">
            <field name="fecha" eval="(DateTime.now() + timedelta(days=3)).strftime('%Y-%m-%d')"/>
            <field name="agent_id" ref="galgo_agent_steven"/>
            <field name="shift_id" ref="galgo_shift_noche"/>
            <field name="state">draft</field>
        </record>

        <record id="demo_schedule_thu_kiara" model="galgo.agent.schedule">
            <field name="fecha" eval="(DateTime.now() + timedelta(days=3)).strftime('%Y-%m-%d')"/>
            <field name="agent_id" ref="galgo_agent_kiara"/>
