<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!--
            Turnos de ejemplo para la semana actual del área NOC.
            Datos demo - se instalan solo con demo data.
        -->

        <!-- Lunes (hoy) -->
        <record id="demo_schedule_mon_jhostin" model="galgo.agent.schedule">
            <field name="fecha" eval="time.strftime('%Y-%m-%d')"/>
            <field name="agent_id" ref="galgo_agent_jhostin"/>
            <field name="shift_id" ref="galgo_shift_dia"/>
            <field name="state">confirmado</field>
        </record>

        <record id="demo_schedule_mon_kiara" model="galgo.agent.schedule">
            <field name="fecha" eval="time.strftime('%Y-%m-%d')"/>
            <field name="agent_id" ref="galgo_agent_kiara"/>
            <field name="shift_id" ref="galgo_shift_manana"/>
            <field name="state">confirmado</field>
        </record>

        <record id="demo_schedule_mon_gracia" model="galgo.agent.schedule">
            <field name="fecha" eval="time.strftime('%Y-%m-%d')"/>
            <field name="agent_id" ref="galgo_agent_gracia"/>
            <field name="shift_id" ref="galgo_shift_noche"/>
            <field name="state">confirmado</field>
        </record>

        <record id="demo_schedule_mon_steven" model="galgo.agent.schedule">
            <field name="fecha" eval="time.strftime('%Y-%m-%d')"/>
            <field name="agent_id" ref="galgo_agent_steven"/>
            <field name="shift_id" ref="galgo_shift_oficina"/>
            <field name="state">draft</field>
        </record>

        <!-- Martes -->
        <record id="demo_schedule_tue_jhostin" model="galgo.agent.schedule">
            <field name="fecha" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d')"/>
            <field name="agent_id" ref="galgo_agent_jhostin"/>
            <field name="shift_id" ref="galgo_shift_noche"/>
            <field name="state">confirmado</field>
        </record>

        <record id="demo_schedule_tue_kiara" model="galgo.agent.schedule">
