        </record>

        <!-- Viernes -->
        <record id="demo_schedule_fri_jaiver" model="galgo.agent.schedule">
            <field name="fecha" eval="(DateTime.now() + timedelta(days=4)).strftime('%Y-%m-%d')"/>
            <field name="agent_id" ref="galgo_agent_jaiver"/>
            <field name="shift_id" ref="galgo_shift_dia"/>
            <field name="state">confirmado</field>
        </record>

        <record id="demo_schedule_fri_gracia" model="galgo.agent.schedule">
            <field name="fecha" eval="(DateTime.now() + timedelta(days=4)).strftime('%Y-%m-%d')"/>
            <field name="agent_id" ref="galgo_agent_gracia"/>
